{
  "name": "@es-joy/jsdoccomment",
  "version": "0.92.0",
  "author": "Brett Zamir <brettz9@yahoo.com>",
  "contributors": [],
  "description": "Maintained replacement for ESLint's deprecated SourceCode#getJSDocComment along with other jsdoc utilities",
  "license": "MIT",
  "keywords": [
    "ast",
    "comment",
    "estree",
    "jsdoc",
    "parser",
    "eslint",
    "sourcecode"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "browserslist": [
    "defaults, not op_mini all"
  ],
  "scripts": {
    "start": "static -p 8070",
    "attw": "attw --pack . --profile esm-only",
    "copy": "cp -R node_modules/prismjs/ demo/vendor/prismjs/ && cp -R node_modules/@webcoder49/code-input/ demo/vendor/@webcoder49/code-input/ && cp node_modules/esquery/dist/esquery.esm.js demo/vendor/esquery/dist/esquery.esm.js && cp -R node_modules/jsdoc-type-pratt-parser/dist demo/vendor/jsdoc-type-pratt-parser && cp -R node_modules/comment-parser/es6 demo/vendor/comment-parser",
    "build": "npm run copy && npm run types",
    "docs": "typedoc-pkg --api-link es",
    "eslint": "eslint .",
    "lint": "npm run eslint --",
    "open": "open ./coverage/index.html",
    "prepublishOnly": "pnpm i && npm run build",
    "test": "npm run lint && npm run build && npm run test-cov",
    "test-ui": "vitest --ui --coverage",
    "test-cov": "vitest --coverage",
    "tsc": "tsc",
    "types": "esm-d-ts gen ./src/index.js --output ./dist/index.d.ts"
  },
  "typedocOptions": {
    "dmtLinksService": {
      "GitHub": "https://github.com/es-joy/jsdoccomment",
      "NPM": "https://www.npmjs.com/package/@es-joy/jsdoccomment"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/es-joy/jsdoccomment.git"
  },
  "bugs": {
    "url": "https://github.com/es-joy/jsdoccomment/issues"
  },
  "homepage": "https://github.com/es-joy/jsdoccomment",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "dependencies": {
    "@types/estree": "^1.0.9",
    "@typescript-eslint/types": "^8.65.0",
    "comment-parser": "1.4.7",
    "esquery": "^1.7.0",
    "jsdoc-type-pratt-parser": "~9.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@brettz9/node-static": "^0.1.1",
    "@types/esquery": "^1.5.4",
    "@types/estraverse": "^5.1.7",
    "@typescript-eslint/visitor-keys": "^8.65.0",
    "@typhonjs-build-test/esm-d-ts": "0.4.0",
    "@typhonjs-typedoc/typedoc-pkg": "^0.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@webcoder49/code-input": "^2.8.3",
    "eslint": "^10.8.0",
    "eslint-config-ash-nazg": "41.1.1",
    "eslint-plugin-jsdoc": "^63.3.2",
    "espree": "^11.2.0",
    "estraverse": "^5.3.0",
    "prismjs": "^1.30.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "/dist",
    "/src",
    "CHANGES.md",
    "LICENSE-MIT.txt"
  ]
}
